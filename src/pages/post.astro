---
import Base from '../layouts/Base.astro';
---
<Base title="Trek partner post | Trekking Partners Nepal" description="A trekker looking for partners in Nepal." noindex>
  <section class="section post-page">
    <div class="container narrow">
      <nav class="crumbs-dark"><a href="/find-partners/">Find partners</a> › <span id="crumb">Post</span></nav>

      <div id="loading" class="panel" style="text-align:center"><p class="muted" style="margin:0">Loading…</p></div>
      <div id="missing" class="panel panel-dashed" hidden>
        <h3>Post not found</h3>
        <p class="muted">It may have been deleted by the trekker.</p>
        <a href="/find-partners/" class="btn btn-sun">Browse other posts</a>
      </div>

      <div id="app" hidden>
        <p id="new-note" class="form-note" hidden>✓ Your post is live. Other trekkers can now find it and reply. You can close it from <a href="/account/">My account</a> once you’ve found partners.</p>

        <article class="trip">
          <div class="trip-top">
            <span id="t-region" class="post-region"></span>
            <h1 id="t-trek"></h1>
            <div class="trip-chips">
              <span id="t-dates" class="post-dates"></span>
              <span id="t-tags" class="post-tags"></span>
            </div>
          </div>

          <div class="author">
            <a id="a-avatar-link" href="#" aria-hidden="true" tabindex="-1"><span id="a-avatar"></span></a>
            <div>
              <a id="a-name" class="author-name" href="#"></a>
              <div id="a-facts" class="post-sub"></div>
            </div>
            <span id="t-time" class="post-sub when"></span>
          </div>

          <p id="t-text" class="trip-text"></p>

          <div class="trip-links">
            <a id="t-treklink" class="link-arrow" href="#">About this trek →</a>
            <span id="t-report" hidden></span>
            <div id="owner" class="owner" hidden>
              <a id="edit" class="btn btn-outline btn-sm" href="#" hidden>Edit</a>
              <button id="toggle" type="button" class="btn btn-outline btn-sm"></button>
              <button id="delete" type="button" class="btn btn-outline btn-sm danger">Delete</button>
            </div>
          </div>
        </article>

        <div id="share" class="share">
          <span id="share-label" class="share-label">Know someone going this way? Share this post</span>
          <div class="share-btns">
            <button type="button" id="sh-native" class="sh sh-native" hidden>Share…</button>
            <a id="sh-wa" class="sh sh-wa" target="_blank" rel="noopener">WhatsApp</a>
            <a id="sh-fb" class="sh sh-fb" target="_blank" rel="noopener">Facebook</a>
            <button type="button" id="sh-copy" class="sh">Copy link</button>
          </div>
        </div>

        <section class="replies" id="replies">
          <h2 id="r-title">Replies</h2>

          <!-- Not signed in / no profile -->
          <div id="r-locked" class="panel locked" hidden>
            <p class="lock-icon" aria-hidden="true">🔒</p>
            <h3 id="r-locked-title"></h3>
            <p class="muted" id="r-locked-text"></p>
            <button id="r-locked-btn" type="button" class="btn btn-sun"></button>
          </div>

          <!-- Members -->
          <div id="r-member" hidden>
            <div id="r-list" class="r-list"></div>
            <p id="r-none" class="muted" hidden>No replies yet. Be the first to say hi!</p>

            <form id="r-form" class="form-card form-grid reply-form" novalidate>
              <label class="field">Your reply
                <textarea name="body" required maxlength="1000" placeholder="Introduce yourself and say how you’d like to plan the trek. You can share your WhatsApp, email or Instagram here to continue the conversation."></textarea>
                <span class="counter" id="r-counter">0 / 1000</span>
              </label>
              <p class="form-note">Replies are visible only to signed-in members with a profile. Share contact details only with people you’re comfortable trekking with, and meet in a public place first. <a href="/safety/">Read our safety tips</a>.</p>
              <p id="r-error" class="form-error" hidden></p>
              <div style="display:flex;justify-content:flex-end"><button type="submit" id="r-send" class="btn btn-sun">Post reply</button></div>
            </form>
          </div>
        </section>

        <section id="similar" class="similar" hidden>
          <h2 id="similar-title">Other trekkers going around the same time</h2>
          <div id="similar-list" class="post-grid"></div>
          <a id="similar-more" class="link-arrow" href="/find-partners/">See all partner posts →</a>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .replies { scroll-margin-top: 90px; }
  :global(.reply-flash) { animation: reply-flash 2.4s ease-out; border-radius: 12px; }
  @keyframes reply-flash { from { background: #ffe8d9; } to { background: transparent; } }
  .narrow { max-width: 760px; }
  .muted { color: var(--muted); }
  .crumbs-dark { font-size: .88rem; color: var(--muted); margin-bottom: 14px; }
  .crumbs-dark a { color: var(--sky-600); text-decoration: none; }
  #new-note { margin-bottom: 18px; }

  .share { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 16px; padding: 14px 18px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .share.owner-share { background: linear-gradient(90deg, #fff4ec, var(--white)); border-color: #f7c9a8; }
  .share-label { font-weight: 600; font-size: .92rem; }
  .share-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .sh { display: inline-flex; align-items: center; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--sky-700); font: 600 .86rem var(--font-body); text-decoration: none; cursor: pointer; }
  .sh:hover { border-color: var(--sky-400); }
  .sh-wa { background: #25d366; border-color: #25d366; color: #fff; }
  .sh-wa:hover { background: #1ebe5a; border-color: #1ebe5a; }
  .sh-fb { background: #1877f2; border-color: #1877f2; color: #fff; }
  .sh-fb:hover { background: #0f66d8; border-color: #0f66d8; }
  .sh-native { background: var(--sun); border-color: var(--sun); color: #fff; }

  .similar { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--line); }
  .similar h2 { font-size: 1.4rem; margin-bottom: 16px; }
  .similar .post-grid { margin-bottom: 18px; }

  .trip { background: var(--white); border: 1px solid var(--line); border-radius: 18px; padding: 28px; box-shadow: var(--shadow); }
  .trip-top h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); margin: 4px 0 12px; }
  .trip-chips { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .author { display: flex; align-items: center; gap: 12px; margin: 24px 0 18px; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .author :global(.avatar) { width: 52px; height: 52px; font-size: 1.2rem; }
  .author-name { display: block; font-weight: 600; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  .author-name:hover { color: var(--sky-600); text-decoration: underline; }
  .when { margin-left: auto; white-space: nowrap; }
  .trip-text { white-space: pre-wrap; font-size: 1.02rem; line-height: 1.7; margin: 0 0 20px; overflow-wrap: anywhere; }
  .trip-links { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .owner { display: flex; gap: 8px; }
  #t-report { margin-left: auto; }
  .danger { color: #b3261e !important; }

  .replies { margin-top: 40px; }
  .replies h2 { font-size: 1.4rem; }
  .locked { text-align: center; padding: 34px 24px; background: linear-gradient(180deg, var(--sky-100), var(--white)); }
  .lock-icon { font-size: 1.8rem; margin: 0; }
  .r-list { display: grid; gap: 14px; margin-bottom: 24px; }
  .r-list :global(.reply) { display: flex; gap: 12px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .r-list :global(.reply.mine) { border-color: var(--sky-200); background: var(--sky-50); }
  .r-list :global(.reply .avatar) { width: 40px; height: 40px; }
  .r-list :global(.reply-body) { flex: 1; min-width: 0; }
  .r-list :global(.reply-head) { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .r-list :global(.reply-name) { font-weight: 600; color: var(--ink); text-decoration: none; }
  .r-list :global(.reply-name:hover) { color: var(--sky-600); text-decoration: underline; }
  .r-list :global(.reply-text) { white-space: pre-wrap; margin: 6px 0 0; overflow-wrap: anywhere; }
  .r-list :global(.reply-del) { background: none; border: 0; color: var(--muted); font: 500 .8rem var(--font-body); cursor: pointer; margin-left: auto; }
  .r-list :global(.reply-del:hover) { color: #b3261e; }
  .reply-form textarea { min-height: 110px; }
  .r-list :global(.reply-edit) { margin-left: auto; }
  .r-list :global(.reply-edit + .reply-del) { margin-left: 0; }
  .r-list :global(.reply-edited) { display: block; margin-top: 4px; font-size: .78rem; color: var(--muted); font-style: italic; }
  .r-list :global(.reply-editor) { margin-top: 8px; }
  .r-list :global(.reply-editor textarea) { width: 100%; box-sizing: border-box; font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; resize: vertical; min-height: 110px; }
  .r-list :global(.reply-edit-row) { display: flex; gap: 8px; justify-content: flex-end; margin-top: 8px; }
  .r-list :global(.reply.admin-reply) { border-color: var(--sky-200); background: var(--sky-50); }
  .r-list :global(.admin-avatar) { position: relative; flex: 0 0 auto; width: 40px; height: 40px; }
  .r-list :global(.admin-avatar .avatar) { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: var(--white); border: 1px solid var(--line); }
  .r-list :global(.admin-badge) { position: absolute; right: -3px; bottom: -3px; width: 18px; height: 18px; border-radius: 50%; background: var(--sky-600); color: #fff; display: grid; place-items: center; border: 2px solid var(--white); }
  .r-list :global(.admin-who) { display: flex; flex-direction: column; line-height: 1.25; }
  .r-list :global(.admin-tag) { align-self: flex-start; margin-top: 3px; font: 600 .72rem var(--font-body); letter-spacing: .04em; text-transform: uppercase; color: var(--sky-600); background: var(--white); border: 1px solid var(--sky-200); border-radius: 999px; padding: 1px 8px; }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getUser, getMyProfile, isComplete, goToLogin, goToAccount } from '../lib/auth';
  import { fetchTrip, fetchTrips, postCard, avatar, authorName, authorFacts, dateRange, timeAgo, paceLabel, el, type Author, type Trip } from '../lib/posts';
  import { reportButton } from '../lib/report';
  import { getTrek } from '../data/treks';
  import { getRegion } from '../data/regions';

  const $ = (id: string) => document.getElementById(id)!;
  const params = new URLSearchParams(location.search);
  const id = params.get('id') ?? '';

  async function start() {
    const trip = id ? await fetchTrip(id) : null;
    $('loading').hidden = true;
    if (!trip) { $('missing').hidden = false; return; }

    const trek = getTrek(trip.trek);
    const region = getRegion(trip.region);
    const name = trek?.name ?? trip.trek;
    document.title = `${name} – trekking partner wanted | Trekking Partners Nepal`;
    $('crumb').textContent = name;
    $('t-region').textContent = region?.name ?? '';
    $('t-trek').textContent = name;
    $('t-dates').textContent = '🗓 ' + dateRange(trip.start_date, trip.end_date) + (trip.flexible ? ' · flexible' : '');
    const tags = $('t-tags');
    if (trip.group_size) tags.append(el('span', 'badge', `Group of ${trip.group_size}`));
    if (trip.pace) tags.append(el('span', 'badge', paceLabel(trip.pace)));
    if (trip.status === 'closed') tags.append(el('span', 'badge badge-warn', 'Closed – no longer looking'));

    $('a-avatar').replaceChildren(avatar(trip.author, 52));
    $('a-name').textContent = authorName(trip.author);
    const profileUrl = `/trekker/?id=${encodeURIComponent(trip.user_id)}`;
    ($('a-name') as HTMLAnchorElement).href = profileUrl;
    ($('a-avatar-link') as HTMLAnchorElement).href = profileUrl;
    $('a-facts').textContent = authorFacts(trip.author);
    $('t-time').textContent = 'Posted ' + timeAgo(trip.created_at);
    $('t-text').textContent = trip.description;
    if (trek && region) ($('t-treklink') as HTMLAnchorElement).href = `/${region.slug}/${trek.slug}/`;
    else $('t-treklink').hidden = true;
    $('new-note').hidden = !params.has('new');
    $('app').hidden = false;
    setupShare(name, trip.start_date, trip.end_date);
    loadSimilar(trip);

    // Who is viewing?
    const user = await getUser();
    const profile = user ? await getMyProfile(user.id) : null;
    const member = isComplete(profile);
    let admin = false;
    if (user) {
      const { data } = await supabase.rpc('is_admin');
      admin = !!data;
    }

    // Owner / admin controls
    const isOwner = user?.id === trip.user_id;
    if (isOwner) markOwnerShare();
    if (!isOwner) {
      $('t-report').replaceChildren(reportButton('post', trip.id, 'Report post'));
      $('t-report').hidden = false;
    }
    if (isOwner || admin) {
      $('owner').hidden = false;
      const toggle = $('toggle') as HTMLButtonElement;
      if (isOwner) {
        const edit = $('edit') as HTMLAnchorElement;
        edit.href = `/find-partners/new/?edit=${trip.id}`;
        edit.hidden = false;
        toggle.textContent = trip.status === 'open' ? 'Close post' : 'Reopen post';
        toggle.addEventListener('click', async () => {
          await supabase.from('trips').update({ status: trip.status === 'open' ? 'closed' : 'open' }).eq('id', trip.id);
          location.reload();
        });
      } else {
        toggle.hidden = true;
      }
      $('delete').addEventListener('click', async () => {
        if (!confirm('Delete this post and all its replies? This can’t be undone.')) return;
        const { error } = await supabase.from('trips').delete().eq('id', trip.id);
        if (error) return alert('Could not delete: ' + error.message);
        location.href = isOwner ? '/account/' : '/find-partners/';
      });
    }

    // Replies
    const n = trip.replies;
    $('r-title').textContent = n === 1 ? '1 reply' : `${n} replies`;
    let banned = false;
    if (member) {
      const { data } = await supabase.rpc('is_banned');
      banned = !!data;
    }
    if (!member || banned) {
      const locked = $('r-locked');
      const btn = $('r-locked-btn') as HTMLButtonElement;
      if (banned) {
        $('r-locked-title').textContent = 'Your account can’t read or post replies';
        $('r-locked-text').textContent = 'It was suspended for breaking our rules. If you think this is a mistake, email hello@trekkingpartnersnepal.com.';
        btn.hidden = true;
      } else if (!user) {
        $('r-locked-title').textContent = n ? `Sign in to read ${n === 1 ? 'the reply' : `the ${n} replies`}` : 'Sign in to reply';
        $('r-locked-text').textContent = 'Replies are for members only, so trekkers can share contact details safely. Signing in with Google takes a few seconds.';
        btn.textContent = 'Sign in with Google';
        btn.addEventListener('click', () => goToLogin());
      } else {
        $('r-locked-title').textContent = 'Complete your profile to see replies';
        $('r-locked-text').textContent = 'Add your name, age and nationality so other trekkers know who they’re talking to.';
        btn.textContent = 'Complete my profile';
        btn.addEventListener('click', () => goToAccount());
      }
      locked.hidden = false;
      // Came from a card's "reply" button? Show the sign-in box.
      if (location.hash === '#reply') locked.scrollIntoView({ block: 'center' });
      return;
    }

    $('r-member').hidden = false;
    loadReplies(user!.id, admin || isOwner);

    const form = $('r-form') as HTMLFormElement;
    const body = form.elements.namedItem('body') as HTMLTextAreaElement;
    body.addEventListener('input', () => { $('r-counter').textContent = `${body.value.length} / 1000`; });
    // Came from a card's "reply" button? Jump to the reply box, ready to type.
    if (location.hash === '#reply') {
      form.scrollIntoView({ block: 'center' });
      body.focus({ preventScroll: true });
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      $('r-error').hidden = true;
      const text = body.value.trim();
      if (!text) return;
      const send = $('r-send') as HTMLButtonElement;
      send.disabled = true;
      const { error } = await supabase.from('comments').insert({ trip_id: trip.id, body: text });
      send.disabled = false;
      if (error) {
        $('r-error').textContent = 'Could not post: ' + error.message;
        $('r-error').hidden = false;
        return;
      }
      body.value = '';
      $('r-counter').textContent = '0 / 1000';
      loadReplies(user!.id, admin || isOwner);
    });
  }

  function adminAvatar() {
    const wrap = el('span', 'admin-avatar');
    const img = el('img', 'avatar');
    img.src = '/web-app-manifest-192x192.png'; img.alt = 'Trekking Partners Nepal'; img.width = 40; img.height = 40;
    wrap.append(img);
    const badge = el('span', 'admin-badge');
    badge.title = 'Admin';
    badge.innerHTML = '<svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.6-4.6 1.4 1.4-6 6Z"/></svg>';
    wrap.append(badge);
    return wrap;
  }

  async function loadReplies(myId: string, canModerate: boolean) {
    const { data: rows } = await supabase
      .from('comments').select('id, user_id, body, created_at, edited_at')
      .eq('trip_id', id).order('created_at', { ascending: true });
    const comments = rows ?? [];
    const ids = [...new Set(comments.map((c) => c.user_id))];
    const [{ data: people }, { data: adminRows }] = await Promise.all([
      ids.length
        ? supabase.from('public_profiles').select('id, display_name, avatar_url, nationality, gender, age').in('id', ids)
        : Promise.resolve({ data: [] as Author[] }),
      supabase.rpc('admin_ids'),
    ]);
    const byId = new Map((people ?? []).map((p: Author) => [p.id, p]));
    const adminIds = new Set<string>((adminRows ?? []).map((r: any) => (typeof r === 'string' ? r : r.admin_ids ?? r.user_id)));

    $('r-title').textContent = comments.length === 1 ? '1 reply' : `${comments.length} replies`;
    $('r-none').hidden = comments.length > 0;
    $('r-list').replaceChildren(...comments.map((c) => {
      const a = byId.get(c.user_id);
      const isAdminReply = adminIds.has(c.user_id);
      const item = el('div', ['reply', c.user_id === myId ? 'mine' : '', isAdminReply ? 'admin-reply' : ''].filter(Boolean).join(' '));
      item.id = `c-${c.id}`;
      const bodyBox = el('div', 'reply-body');
      const head = el('div', 'reply-head');
      if (isAdminReply) {
        // Team account: show the site identity instead of the personal profile
        const who = el('div', 'admin-who');
        const nameLink = el('a', 'reply-name', 'Trekking Partners Nepal');
        nameLink.href = '/about/';
        who.append(nameLink, el('span', 'admin-tag', 'Admin'));
        head.append(who, el('span', 'post-sub', timeAgo(c.created_at)));
      } else {
        const nameLink = el('a', 'reply-name', authorName(a));
        nameLink.href = `/trekker/?id=${encodeURIComponent(c.user_id)}`;
        head.append(nameLink);
        const facts = authorFacts(a);
        head.append(el('span', 'post-sub', [facts, timeAgo(c.created_at)].filter(Boolean).join(' · ')));
      }
      if (c.user_id === myId && adminIds.has(myId)) {
        const edit = el('button', 'reply-del reply-edit', 'Edit');
        edit.type = 'button';
        edit.addEventListener('click', () => openEditor());
        head.append(edit);
      }
      if (c.user_id === myId || canModerate) {
        const del = el('button', 'reply-del', 'Delete');
        del.type = 'button';
        del.addEventListener('click', async () => {
          if (!confirm('Delete this reply?')) return;
          await supabase.from('comments').delete().eq('id', c.id);
          loadReplies(myId, canModerate);
        });
        head.append(del);
      }
      if (c.user_id !== myId && !isAdminReply) {
        const rep = reportButton('reply', c.id);
        if (!(c.user_id === myId || canModerate)) rep.style.marginLeft = 'auto';
        head.append(rep);
      }
      const text = el('p', 'reply-text', c.body);
      bodyBox.append(head, text);
      if (c.edited_at) bodyBox.append(el('span', 'reply-edited', 'Edited'));

      function openEditor() {
        if (bodyBox.querySelector('.reply-editor')) return;
        const box = el('div', 'reply-editor');
        const ta = el('textarea') as HTMLTextAreaElement;
        ta.maxLength = 1000; ta.value = c.body; ta.rows = 5;
        const err = el('p', 'form-note reply-edit-err'); err.hidden = true;
        const row = el('div', 'reply-edit-row');
        const cancel = el('button', 'btn btn-outline btn-sm', 'Cancel'); cancel.type = 'button';
        const save = el('button', 'btn btn-sun btn-sm', 'Save'); save.type = 'button';
        row.append(cancel, save);
        box.append(ta, err, row);
        text.hidden = true;
        text.after(box);
        ta.focus();
        cancel.addEventListener('click', () => { box.remove(); text.hidden = false; });
        save.addEventListener('click', async () => {
          const v = ta.value.trim();
          if (!v) { err.textContent = 'Reply can’t be empty.'; err.hidden = false; return; }
          if (v === c.body) { box.remove(); text.hidden = false; return; }
          save.disabled = true; save.textContent = 'Saving…';
          const { error } = await supabase.from('comments').update({ body: v }).eq('id', c.id);
          if (error) {
            err.textContent = 'Could not save your edit. Please try again.'; err.hidden = false;
            save.disabled = false; save.textContent = 'Save';
            return;
          }
          loadReplies(myId, canModerate);
        });
      }
      item.append(isAdminReply ? adminAvatar() : avatar(a, 40), bodyBox);
      return item;
    }));

    // Came from a notification? Jump to the replies once they're on the page.
    if (!jumped && location.hash === '#replies') {
      jumped = true;
      const last = $('r-list').lastElementChild as HTMLElement | null;
      (last ?? $('replies')).scrollIntoView({ block: 'center' });
      last?.classList.add('reply-flash');
    }
    // Came from a card's "reply" button? Replies have pushed the form down, so scroll to it again.
    if (!jumped && location.hash === '#reply') {
      jumped = true;
      $('r-form').scrollIntoView({ block: 'center' });
    }
  }
  let jumped = false;

  // ── Share ────────────────────────────────────────────────
  function setupShare(trekName: string, start: string, end: string | null) {
    const url = `${location.origin}/post/?id=${encodeURIComponent(id)}`;
    const text = `Looking for trekking partners: ${trekName}, ${dateRange(start, end)}. Join or reply here:`;
    ($('sh-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(text + ' ' + url)}`;
    ($('sh-fb') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
    const copy = $('sh-copy') as HTMLButtonElement;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(url); }
      catch {
        const t = document.createElement('textarea'); t.value = url; document.body.append(t); t.select();
        try { document.execCommand('copy'); } catch {} t.remove();
      }
      copy.textContent = '✓ Link copied';
      setTimeout(() => (copy.textContent = 'Copy link'), 2000);
    });
    if (typeof navigator.share === 'function') {
      const native = $('sh-native') as HTMLButtonElement;
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title: `${trekName} – trekking partner wanted`, text, url }).catch(() => {}));
    }
  }

  function markOwnerShare() {
    $('share').classList.add('owner-share');
    $('share-label').textContent = params.has('new')
      ? '📣 Share your post to find partners faster'
      : 'Share your post in groups and chats to find partners faster';
  }

  // ── Similar posts ────────────────────────────────────────
  async function loadSimilar(trip: Trip) {
    let pool: Trip[] = [];
    try {
      const [sameTrek, sameRegion] = await Promise.all([
        fetchTrips({ trek: trip.trek }),
        fetchTrips({ region: trip.region }),
      ]);
      const seen = new Set<string>([trip.id]);
      for (const t of [...sameTrek, ...sameRegion]) if (!seen.has(t.id)) { seen.add(t.id); pool.push(t); }
    } catch { return; }
    if (!pool.length) return;
    // Same trek first, then closest start date
    const day = (d: string) => new Date(d + 'T00:00:00').getTime();
    const target = day(trip.start_date);
    pool.sort((a, b) =>
      (a.trek === trip.trek ? 0 : 1) - (b.trek === trip.trek ? 0 : 1) ||
      Math.abs(day(a.start_date) - target) - Math.abs(day(b.start_date) - target));
    const picks = pool.slice(0, 4);
    const region = getRegion(trip.region);
    $('similar-title').textContent = picks.every((t) => t.trek === trip.trek)
      ? `Others trekking ${getTrek(trip.trek)?.name ?? ''} around the same time`
      : `Others trekking in ${region?.name ?? 'this region'} around the same time`;
    $('similar-list').replaceChildren(...picks.map(postCard));
    if (region) ($('similar-more') as HTMLAnchorElement).href = `/${region.slug}/`;
    $('similar').hidden = false;
  }

  start();
</script>
