---
import Base from '../layouts/Base.astro';
import { countries } from '../data/countries';

const thisYear = new Date().getFullYear();
const years = Array.from({ length: thisYear - 18 - 1930 + 1 }, (_, i) => thisYear - 18 - i);
---
<Base title="My account | Trekking Partners Nepal" description="Your trekker profile and posts." noindex>
  <section class="section account">
    <div class="container narrow">

      <div id="loading" class="panel" style="text-align:center"><p class="muted" style="margin:0">Loading your account…</p></div>

      <div id="app" hidden>
        <div class="acc-head">
          <span id="acc-avatar"></span>
          <div>
            <span class="eyebrow">My account</span>
            <h1 id="acc-title">Your trekker profile</h1>
            <p class="muted" id="acc-email"></p>
            <a id="acc-public" class="link-arrow" href="#" hidden>View my public profile →</a>
          </div>
        </div>

        <p id="welcome" class="form-note" hidden>
          Welcome! Fill in your profile to post treks and read replies. Other trekkers see your name, age, gender (if you add it) and nationality on your posts – never your email or birth year.
        </p>

        <form id="profile" class="form-card form-grid" novalidate>
          <h2 class="form-title">Profile</h2>
          <label class="field">Name <span class="hint">shown on your posts and replies</span>
            <input name="display_name" required minlength="2" maxlength="50" autocomplete="name" />
          </label>
          <div class="field-row">
            <label class="field">Birth year <span class="hint">only your age is shown</span>
              <select name="birth_year" required>
                <option value="">Select…</option>
                {years.map((y) => <option value={y}>{y}</option>)}
              </select>
            </label>
            <label class="field">Gender <span class="hint">optional</span>
              <select name="gender">
                <option value="">Prefer not to say</option>
                <option value="female">Female</option>
                <option value="male">Male</option>
                <option value="non-binary">Non-binary</option>
              </select>
            </label>
          </div>
          <label class="field">Nationality
            <select name="nationality" required>
              <option value="">Select…</option>
              {countries.map((c) => <option value={c}>{c}</option>)}
            </select>
          </label>
          <label class="field">About you <span class="hint">optional · shown only on your profile page, not on your posts</span>
            <textarea name="bio" maxlength="300" rows="3" placeholder="E.g. Photographer from Berlin, third time in Nepal. I like an early start and a slow, steady pace."></textarea>
            <span class="counter" id="bio-counter">0 / 300</span>
          </label>
          <p class="hint-note">Don’t put your phone number or email here – profiles are public.</p>
          <p id="profile-error" class="form-error" hidden></p>
          <div class="form-actions">
            <button type="submit" id="save" class="btn btn-sun">Save profile</button>
            <span id="saved" class="saved" hidden>✓ Saved</span>
          </div>
        </form>

        <div class="form-card email-card">
          <h2 class="form-title">Email alerts</h2>
          <label class="check-field"><input type="checkbox" id="email-replies" /> Email me when someone replies to my posts, or to a post I replied on</label>
          <p class="muted small">Sent to <span id="email-to"></span>. At most one email per post every 30 minutes.</p>
          <span id="email-saved" class="saved" hidden>✓ Saved</span>
        </div>

        <div class="my-posts">
          <div class="section-head" style="margin-bottom:16px">
            <h2>My posts</h2>
            <a href="/find-partners/new/" class="btn btn-sun btn-sm">+ Post a trek</a>
          </div>
          <div id="my-posts" class="my-list"></div>
          <p id="no-posts" class="muted" hidden>You haven’t posted a trek yet.</p>
        </div>

        <button id="signout" type="button" class="btn btn-outline" style="margin-top:32px">Sign out</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }
  .muted { color: var(--muted); }
  .acc-head { display: flex; align-items: center; gap: 18px; margin-bottom: 24px; }
  .acc-head h1 { font-size: 2rem; margin-bottom: 2px; }
  .acc-head p { margin: 0; }
  .acc-head :global(.avatar) { width: 72px; height: 72px; font-size: 1.6rem; }
  .form-title { font-size: 1.3rem; margin: 0; }
  .form-actions { display: flex; align-items: center; gap: 14px; }
  .saved { color: #1b7a47; font-weight: 600; }
  .field textarea[name=bio] { min-height: 90px; }
  .hint-note { font-size: .82rem; color: var(--muted); margin: -8px 0 0; }
  #welcome { margin-bottom: 20px; }
  .my-posts { margin-top: 48px; }
  .email-card { margin-top: 24px; display: grid; gap: 10px; }
  .small { font-size: .86rem; margin: 0; }
  .my-list { display: grid; gap: 12px; }
  .my-list :global(.mine) { display: flex; justify-content: space-between; align-items: center; gap: 16px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; flex-wrap: wrap; }
  .my-list :global(.mine a.title) { font-weight: 600; color: var(--ink); text-decoration: none; }
  .my-list :global(.mine a.title:hover) { color: var(--sky-600); }
  .my-list :global(.mine .sub) { font-size: .85rem; color: var(--muted); }
  .my-list :global(.mine .acts) { display: flex; gap: 6px; }
  .my-list :global(.mine button) { background: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font: 600 .85rem var(--font-body); color: var(--sky-700); cursor: pointer; }
  .my-list :global(.mine button:hover) { border-color: var(--sky-400); }
  .my-list :global(.mine button.danger) { color: #b3261e; }
  .my-list :global(.mine .edit-link) { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font: 600 .85rem var(--font-body); color: var(--sky-700); text-decoration: none; }
  .my-list :global(.mine .edit-link:hover) { border-color: var(--sky-400); }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getUser, getMyProfile, isComplete, goToLogin, takeNext, peekNext } from '../lib/auth';
  import { fetchTrips, avatar, dateRange, el } from '../lib/posts';
  import { getTrek } from '../data/treks';

  const form = document.getElementById('profile') as HTMLFormElement;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;
  const errorBox = document.getElementById('profile-error')!;

  async function start() {
    const user = await getUser();
    if (!user) return goToLogin('/account/');

    let profile = await getMyProfile(user.id);
    if (!profile) {
      // safety net: the sign-up trigger normally creates this row
      const meta = user.user_metadata || {};
      await supabase.from('profiles').insert({ id: user.id, display_name: meta.full_name || meta.name || null, avatar_url: meta.avatar_url || null });
      profile = await getMyProfile(user.id);
    }

    document.getElementById('acc-email')!.textContent = user.email ?? '';
    const pub = document.getElementById('acc-public') as HTMLAnchorElement;
    pub.href = `/trekker/?id=${user.id}`;
    pub.hidden = !isComplete(profile);
    document.getElementById('acc-avatar')!.replaceChildren(
      avatar({ id: user.id, display_name: profile?.display_name ?? null, avatar_url: profile?.avatar_url ?? user.user_metadata?.avatar_url ?? null, nationality: null, gender: null, age: null }, 72),
    );
    f('display_name').value = profile?.display_name ?? '';
    f('birth_year').value = profile?.birth_year ? String(profile.birth_year) : '';
    f('gender').value = profile?.gender ?? '';
    f('nationality').value = profile?.nationality ?? '';
    const bio = form.elements.namedItem('bio') as HTMLTextAreaElement;
    const bioCount = () => { document.getElementById('bio-counter')!.textContent = `${bio.value.length} / 300`; };
    bio.value = profile?.bio ?? '';
    bioCount();
    bio.addEventListener('input', bioCount);

    const needsSetup = !isComplete(profile);
    document.getElementById('welcome')!.hidden = !(needsSetup || new URLSearchParams(location.search).has('complete'));
    if (needsSetup) document.getElementById('acc-title')!.textContent = 'Set up your profile';

    document.getElementById('loading')!.hidden = true;
    document.getElementById('app')!.hidden = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      const name = f('display_name').value.trim();
      if (name.length < 2) return showError('Please enter your name (at least 2 characters).');
      if (!f('birth_year').value) return showError('Please choose your birth year.');
      if (!f('nationality').value) return showError('Please choose your nationality.');

      const save = document.getElementById('save') as HTMLButtonElement;
      save.disabled = true;
      const { error } = await supabase.from('profiles').update({
        display_name: name,
        birth_year: Number(f('birth_year').value),
        gender: f('gender').value || null,
        nationality: f('nationality').value,
        bio: bio.value.trim() || null,
      }).eq('id', user.id);
      save.disabled = false;
      if (error) return showError('Could not save: ' + error.message);

      const saved = document.getElementById('saved')!;
      saved.hidden = false;
      setTimeout(() => (saved.hidden = true), 2500);
      document.getElementById('acc-title')!.textContent = 'Your trekker profile';

      // Came here to finish setting up? Go back to where they were.
      const next = peekNext() ? takeNext() : null;
      if (next) location.href = next;
    });

    // Email alerts
    const box = document.getElementById('email-replies') as HTMLInputElement;
    document.getElementById('email-to')!.textContent = user.email ?? 'your Google email';
    const { data: pref } = await supabase.from('profiles').select('email_replies').eq('id', user.id).maybeSingle();
    box.checked = pref?.email_replies ?? true;
    box.addEventListener('change', async () => {
      const { error } = await supabase.from('profiles').update({ email_replies: box.checked }).eq('id', user.id);
      if (error) { box.checked = !box.checked; alert('Could not save: ' + error.message); return; }
      const s = document.getElementById('email-saved')!;
      s.hidden = false; setTimeout(() => (s.hidden = true), 2000);
    });

    loadMyPosts(user.id);
  }

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
  }

  async function loadMyPosts(userId: string) {
    const list = document.getElementById('my-posts')!;
    let trips;
    try { trips = await fetchTrips({ userId, all: true }); } catch { trips = []; }
    document.getElementById('no-posts')!.hidden = trips.length > 0;

    list.replaceChildren(...trips.map((t) => {
      const row = el('div', 'mine');
      const info = el('div');
      const link = el('a', 'title', getTrek(t.trek)?.name ?? t.trek);
      link.href = `/post/?id=${t.id}`;
      const sub = el('div', 'sub',
        `${dateRange(t.start_date, t.end_date)} · ${t.replies} ${t.replies === 1 ? 'reply' : 'replies'} · ${t.status === 'open' ? 'Open' : 'Closed'}`);
      info.append(link, sub);

      const acts = el('div', 'acts');
      const toggle = el('button', '', t.status === 'open' ? 'Close' : 'Reopen');
      toggle.type = 'button';
      toggle.title = t.status === 'open' ? 'Found your partners? Close the post so it stops showing.' : 'Show this post again';
      toggle.addEventListener('click', async () => {
        await supabase.from('trips').update({ status: t.status === 'open' ? 'closed' : 'open' }).eq('id', t.id);
        loadMyPosts(userId);
      });
      const del = el('button', 'danger', 'Delete');
      del.type = 'button';
      del.addEventListener('click', async () => {
        if (!confirm('Delete this post and all its replies? This can’t be undone.')) return;
        await supabase.from('trips').delete().eq('id', t.id);
        loadMyPosts(userId);
      });
      const edit = el('a', 'edit-link', 'Edit');
      edit.href = `/find-partners/new/?edit=${t.id}`;
      acts.append(edit, toggle, del);
      row.append(info, acts);
      return row;
    }));
  }

  document.getElementById('signout')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    location.href = '/';
  });

  start();
</script>
