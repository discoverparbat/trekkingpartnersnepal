---
import Base from '../layouts/Base.astro';
import { regions } from '../data/regions';
import { treksInRegion } from '../data/treks';
---
<Base title="Admin | Trekking Partners Nepal" description="Admin area." noindex>
  <section class="section admin">
    <div class="container">

      <!-- Sign-in / access check -->
      <div id="gate" class="panel gate">
        <p id="gate-msg">Checking your access…</p>
        <button id="signin" type="button" class="btn btn-sun" hidden>Sign in with Google</button>
        <button id="gate-signout" type="button" class="btn btn-outline" hidden>Sign out</button>
      </div>

      <!-- Admin app -->
      <div id="app" hidden>
        <div class="admin-head">
          <div>
            <span class="eyebrow">Admin</span>
            <h1 id="admin-title">Fixed departures</h1>
            <p class="muted" id="admin-lead">Changes appear on the homepage, the fixed departures page and trek pages straight away.</p>
          </div>
          <div class="head-actions">
            <button id="add" type="button" class="btn btn-sun">+ Add departure</button>
            <button id="signout" type="button" class="btn btn-outline">Sign out</button>
          </div>
        </div>

        <div class="tabs" role="tablist">
          <button type="button" role="tab" class="tab on" data-tab="departures" aria-selected="true">Fixed departures</button>
          <button type="button" role="tab" class="tab" data-tab="moderation" aria-selected="false">Moderation <span id="open-count" class="count" hidden></span></button>
        </div>

        <div id="tab-departures">
        <h2 class="list-title">Upcoming</h2>
        <div class="table-wrap"><table><thead><tr>
          <th>Date</th><th>Trek</th><th>Days</th><th>Price</th><th>Seats</th><th>Status</th><th></th>
        </tr></thead><tbody id="rows-upcoming"></tbody></table></div>
        <p id="none-upcoming" class="muted" hidden>No upcoming departures. Click “Add departure” to create one.</p>

        <details class="past">
          <summary>Past departures</summary>
          <div class="table-wrap"><table><thead><tr>
            <th>Date</th><th>Trek</th><th>Days</th><th>Price</th><th>Seats</th><th>Status</th><th></th>
          </tr></thead><tbody id="rows-past"></tbody></table></div>
        </details>
        </div>

        <!-- Moderation -->
        <div id="tab-moderation" hidden>
          <div class="mod-section-head">
            <h2 class="list-title">Reports</h2>
            <div class="filter">
              <button type="button" class="on" data-report-filter="open">Open</button>
              <button type="button" data-report-filter="all">All</button>
            </div>
          </div>
          <div id="report-list" class="mod-list"></div>
          <p id="none-reports" class="muted" hidden>No open reports.</p>

          <h2 class="list-title mod-gap">Latest posts</h2>
          <div class="table-wrap"><table><thead><tr>
            <th>Posted</th><th>By</th><th>Post</th><th></th>
          </tr></thead><tbody id="recent-posts"></tbody></table></div>
          <p id="none-posts" class="muted" hidden>No posts yet.</p>

          <h2 class="list-title mod-gap">Latest replies</h2>
          <div class="table-wrap"><table><thead><tr>
            <th>Posted</th><th>By</th><th>Reply</th><th></th>
          </tr></thead><tbody id="recent-replies"></tbody></table></div>
          <p id="none-replies" class="muted" hidden>No replies yet.</p>

          <div class="mod-section-head mod-gap">
            <h2 class="list-title">Members <span id="member-count" class="muted"></span></h2>
            <input id="member-search" type="search" placeholder="Search name, email or country" />
          </div>
          <div class="table-wrap"><table><thead><tr>
            <th>Name</th><th>Email</th><th>Nationality</th><th>Joined</th><th>Posts / replies</th><th></th>
          </tr></thead><tbody id="members"></tbody></table></div>
        </div>
      </div>

      <div id="toast" role="status" hidden></div>
    </div>
  </section>

  <!-- Add / edit form -->
  <dialog id="dlg">
    <form id="form" method="dialog">
      <h2 id="form-title">Add departure</h2>
      <input type="hidden" name="id" />

      <label>Trek
        <select name="trek" required>
          <option value="">Choose a trek…</option>
          {regions.map((r) => (
            <optgroup label={r.name}>
              {treksInRegion(r.slug).map((t) => <option value={t.slug}>{t.name}</option>)}
            </optgroup>
          ))}
        </select>
      </label>

      <div class="row">
        <label>Start date <input type="date" name="start_date" required /></label>
        <label>Days <input type="number" name="days" min="1" max="60" required /></label>
      </div>

      <label>Price <span class="hint">optional – leave empty to show “Ask for price”</span>
        <input type="text" name="price" placeholder="e.g. US$ 650" maxlength="40" />
      </label>

      <div class="row">
        <label>Group size (max) <input type="number" name="group_max" min="1" max="50" value="12" required /></label>
        <label>Seats left <input type="number" name="seats_left" min="0" max="50" value="12" required /></label>
      </div>

      <fieldset class="details">
        <legend>Departure page details <span class="hint">all optional</span></legend>
        <p id="copied-note" class="copied" hidden>Details copied from your last departure of this trek – edit as needed.</p>
        <label>Overview
          <textarea name="overview" rows="3" maxlength="2000" placeholder="A few lines about this departure: the route, who it suits, what makes it special."></textarea>
        </label>
        <label>Itinerary <span class="hint">one day per line</span>
          <textarea name="itinerary" rows="6" maxlength="6000" placeholder="Day 1: Drive Pokhara to Kande, trek to Australian Camp&#10;Day 2: Trek to Forest Camp&#10;Day 3: …"></textarea>
        </label>
        <div class="row">
          <label>Included <span class="hint">one per line</span>
            <textarea name="included" rows="5" maxlength="3000" placeholder="Licensed guide&#10;Permits&#10;Teahouse rooms"></textarea>
          </label>
          <label>Not included <span class="hint">one per line</span>
            <textarea name="not_included" rows="5" maxlength="3000" placeholder="Travel insurance&#10;Drinks and snacks&#10;Tips"></textarea>
          </label>
        </div>
        <label>Meeting point
          <input type="text" name="meeting_point" maxlength="300" placeholder="e.g. Our office in Lakeside, Pokhara – 7:00 am" />
        </label>
      </fieldset>

      <label class="check"><input type="checkbox" name="published" checked /> Show on the website</label>

      <p id="form-error" class="error" hidden></p>

      <div class="form-actions">
        <button type="button" id="cancel" class="btn btn-outline">Cancel</button>
        <button type="submit" id="save" class="btn btn-sun">Save</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  .admin { min-height: 70vh; }
  .muted { color: var(--muted); }
  .gate { max-width: 460px; margin: 40px auto; text-align: center; display: grid; gap: 14px; justify-items: center; }
  .admin-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
  .admin-head h1 { font-size: 2.2rem; }
  .admin-head p { margin: 0; }
  .head-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .list-title { font-size: 1.2rem; margin-bottom: 12px; }

  .table-wrap { overflow-x: auto; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: .93rem; min-width: 720px; }
  th { text-align: left; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; padding: 12px 14px; background: var(--sky-50); border-bottom: 1px solid var(--line); }
  td { padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  tbody tr:last-child td { border-bottom: 0; }
  td.actions { white-space: nowrap; text-align: right; }
  td.actions button { background: none; border: 0; color: var(--sky-600); font: 600 .88rem var(--font-body); cursor: pointer; padding: 4px 8px; border-radius: 6px; }
  td.actions button:hover { background: var(--sky-100); }
  td.actions button.danger { color: #b3261e; }
  td.actions button.danger:hover { background: #fde8e8; }
  .tag { display: inline-block; font-size: .74rem; font-weight: 600; padding: 3px 9px; border-radius: 999px; }
  .tag.on { background: #e3f6ec; color: #1b7a47; }
  .tag.off { background: #eef0f3; color: var(--muted); }
  .tag.full { background: #fff1e6; color: var(--sun-dark); }
  tr.hidden-row td { opacity: .6; }

  .past { margin-top: 32px; }
  .past summary { cursor: pointer; font-weight: 600; margin-bottom: 12px; color: var(--sky-700); }

  dialog { border: 0; border-radius: 18px; padding: 0; width: min(640px, calc(100vw - 32px)); max-height: 92vh; overflow-y: auto; box-shadow: 0 30px 80px -20px rgba(8,22,52,.5); }
  dialog::backdrop { background: rgba(8,22,52,.55); backdrop-filter: blur(2px); }
  form { padding: 26px; display: grid; gap: 14px; }
  form h2 { font-size: 1.4rem; margin: 0; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: .9rem; }
  .hint { font-weight: 400; color: var(--muted); font-size: .8rem; }
  textarea { resize: vertical; line-height: 1.5; }
  .details { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px 16px; margin: 4px 0 0; display: grid; gap: 12px; }
  .details legend { font-weight: 700; padding: 0 6px; }
  .copied { margin: 0; font-size: .85rem; color: #1b7a47; background: #e3f6ec; border-radius: 8px; padding: 8px 12px; }
  input, select, textarea { font: 400 1rem var(--font-body); padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: var(--ink); width: 100%; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--sky-400); outline-offset: 1px; border-color: var(--sky-400); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .check { display: flex; align-items: center; gap: 10px; font-weight: 500; }
  .check input { width: 18px; height: 18px; }
  .error { color: #b3261e; margin: 0; font-size: .9rem; }
  .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

  .tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--line); margin-bottom: 26px; }
  .tab { background: none; border: 0; border-bottom: 3px solid transparent; padding: 10px 14px; font: 600 .95rem var(--font-body); color: var(--muted); cursor: pointer; margin-bottom: -1px; display: inline-flex; align-items: center; gap: 8px; }
  .tab.on { color: var(--ink); border-bottom-color: var(--sun); }
  .count { background: #b3261e; color: var(--white); border-radius: 999px; font-size: .72rem; padding: 1px 8px; }
  .mod-section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .mod-section-head .list-title { margin: 0; }
  .mod-section-head input { width: min(300px, 100%); }
  .mod-gap { margin-top: 40px; }
  .filter { display: flex; background: var(--white); border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
  .filter button { background: none; border: 0; border-radius: 999px; padding: 6px 14px; font: 600 .85rem var(--font-body); color: var(--muted); cursor: pointer; }
  .filter button.on { background: var(--sky-100); color: var(--sky-700); }
  .mod-list { display: grid; gap: 12px; }
  .mod-card { background: var(--white); border: 1px solid var(--line); border-left: 4px solid #b3261e; border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 10px; }
  .mod-card.status-resolved, .mod-card.status-dismissed { border-left-color: var(--line); opacity: .75; }
  .mod-head { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .mod-head .tag { background: var(--sky-100); color: var(--sky-700); }
  .mod-head .tag.off { background: #eef0f3; color: var(--muted); }
  .mod-when { margin-left: auto; font-size: .82rem; color: var(--muted); }
  .mod-details { margin: 0; font-style: italic; color: #33445c; overflow-wrap: anywhere; }
  .mod-target { background: var(--sky-50); border-radius: 10px; padding: 10px 14px; overflow-wrap: anywhere; }
  .mod-target p { margin: 4px 0 0; font-size: .92rem; white-space: pre-wrap; }
  .mod-title { font-weight: 600; font-size: .92rem; }
  .mod-actions { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .mod-actions button, .mod-actions .mod-link { background: none; border: 1px solid var(--line); color: var(--sky-700); font: 600 .84rem var(--font-body); cursor: pointer; padding: 6px 12px; border-radius: 999px; text-decoration: none; }
  .mod-actions button:hover, .mod-actions .mod-link:hover { background: var(--sky-100); }
  .mod-actions button.danger { color: #b3261e; border-color: #f3c2c2; }
  .mod-actions button.danger:hover { background: #fde8e8; }
  td.mod-text { max-width: 460px; overflow-wrap: anywhere; }
  td.mod-text .muted { font-size: .86rem; }
  td.nowrap { white-space: nowrap; }
  td.actions a { color: var(--sky-600); font: 600 .88rem var(--font-body); padding: 4px 8px; text-decoration: none; }

  #toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--night-900); color: var(--white); padding: 12px 20px; border-radius: 999px; font-size: .92rem; box-shadow: var(--shadow); z-index: 100; }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getTrek } from '../data/treks';
  import { initModeration } from '../lib/moderation';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const gateMsg = $('gate-msg');
  const dlg = $<HTMLDialogElement>('dlg');
  const form = $<HTMLFormElement>('form');
  const formError = $('form-error');
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

  let rows: any[] = [];
  let toastTimer: number | undefined;

  function toast(msg: string) {
    const t = $('toast');
    t.textContent = msg; t.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (t.hidden = true), 3000);
  }

  // ── Access ────────────────────────────────────────────────
  async function checkAccess() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      gateMsg.textContent = 'Sign in with your admin Google account to manage departures.';
      $('signin').hidden = false;
      return;
    }
    const { data: isAdmin, error } = await supabase.rpc('is_admin');
    if (error || !isAdmin) {
      gateMsg.textContent = `${session.user.email} doesn’t have admin access.`;
      $('gate-signout').hidden = false;
      return;
    }
    $('gate').hidden = true;
    $('app').hidden = false;
    load();
    initModeration(toast);
    if (location.hash === '#moderation') showTab('moderation', false);
  }

  // ── Tabs ──────────────────────────────────────────────────
  const LEADS: Record<string, [string, string]> = {
    departures: ['Fixed departures', 'Changes appear on the homepage, the fixed departures page and trek pages straight away.'],
    moderation: ['Moderation', 'Reports from trekkers, the latest posts and replies, and all members. Banned members can’t post, reply or read replies.'],
  };
  function showTab(name: string, reload = true) {
    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) => {
      const on = t.dataset.tab === name;
      t.classList.toggle('on', on);
      t.setAttribute('aria-selected', String(on));
    });
    $('tab-departures').hidden = name !== 'departures';
    $('tab-moderation').hidden = name !== 'moderation';
    $('add').hidden = name !== 'departures';
    $('admin-title').textContent = LEADS[name][0];
    $('admin-lead').textContent = LEADS[name][1];
    history.replaceState(null, '', name === 'moderation' ? '#moderation' : location.pathname);
    if (name === 'moderation' && reload) initModeration(toast);
  }
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) =>
    t.addEventListener('click', () => showTab(t.dataset.tab!)));

  $('signin').addEventListener('click', () =>
    supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: window.location.origin + '/admin/' } }));

  const signOut = async () => { await supabase.auth.signOut(); location.reload(); };
  $('signout').addEventListener('click', signOut);
  $('gate-signout').addEventListener('click', signOut);

  // ── List ──────────────────────────────────────────────────
  async function load() {
    const { data, error } = await supabase.from('departures').select('*').order('start_date', { ascending: true });
    if (error) { toast('Could not load departures: ' + error.message); return; }
    rows = data ?? [];
    render();
  }

  const fmtDate = (d: string) =>
    new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });

  function td(text: string, cls = '') {
    const c = document.createElement('td');
    if (cls) c.className = cls;
    c.textContent = text;
    return c;
  }

  function tag(text: string, cls: string) {
    const s = document.createElement('span');
    s.className = `tag ${cls}`; s.textContent = text;
    return s;
  }

  function actionBtn(label: string, onClick: () => void, cls = '') {
    const b = document.createElement('button');
    b.type = 'button'; b.textContent = label;
    if (cls) b.className = cls;
    b.addEventListener('click', onClick);
    return b;
  }

  function rowEl(r: any) {
    const tr = document.createElement('tr');
    if (!r.published) tr.className = 'hidden-row';
    const status = document.createElement('td');
    status.append(r.published ? tag('On website', 'on') : tag('Hidden', 'off'));
    if (r.seats_left <= 0) { status.append(' '); status.append(tag('Full', 'full')); }

    const actions = document.createElement('td');
    actions.className = 'actions';
    actions.append(
      actionBtn('Edit', () => openForm(r)),
      actionBtn(r.published ? 'Hide' : 'Show', () => togglePublished(r)),
      actionBtn('Delete', () => remove(r), 'danger'),
    );

    tr.append(
      td(fmtDate(r.start_date)),
      td(getTrek(r.trek)?.name ?? r.trek),
      td(String(r.days)),
      td(r.price || '—'),
      td(`${r.seats_left} / ${r.group_max}`),
      status,
      actions,
    );
    return tr;
  }

  function render() {
    const today = new Date().toISOString().slice(0, 10);
    const upcoming = rows.filter((r) => r.start_date >= today);
    const past = rows.filter((r) => r.start_date < today).reverse();
    $('rows-upcoming').replaceChildren(...upcoming.map(rowEl));
    $('rows-past').replaceChildren(...past.map(rowEl));
    $('none-upcoming').hidden = upcoming.length > 0;
  }

  // ── Actions ───────────────────────────────────────────────
  async function togglePublished(r: any) {
    const { error } = await supabase.from('departures').update({ published: !r.published }).eq('id', r.id);
    if (error) return toast('Error: ' + error.message);
    toast(r.published ? 'Hidden from the website' : 'Now showing on the website');
    load();
  }

  async function remove(r: any) {
    const name = getTrek(r.trek)?.name ?? r.trek;
    if (!confirm(`Delete ${name} on ${fmtDate(r.start_date)}? This can’t be undone.`)) return;
    const { error } = await supabase.from('departures').delete().eq('id', r.id);
    if (error) return toast('Error: ' + error.message);
    toast('Departure deleted');
    load();
  }

  // ── Form ──────────────────────────────────────────────────
  function openForm(r?: any) {
    form.reset();
    formError.hidden = true;
    $('form-title').textContent = r ? 'Edit departure' : 'Add departure';
    field('id').value = r?.id ?? '';
    field('trek').value = r?.trek ?? '';
    field('start_date').value = r?.start_date ?? '';
    field('days').value = r ? String(r.days) : '';
    field('price').value = r?.price ?? '';
    field('group_max').value = String(r?.group_max ?? 12);
    field('seats_left').value = String(r?.seats_left ?? 12);
    field('published').checked = r ? r.published : true;
    field('overview').value = r?.overview ?? '';
    field('itinerary').value = r?.itinerary ?? '';
    field('included').value = r?.included ?? '';
    field('not_included').value = r?.not_included ?? '';
    field('meeting_point').value = r?.meeting_point ?? '';
    $('copied-note').hidden = true;
    dlg.showModal();
  }

  $('add').addEventListener('click', () => openForm());
  $('cancel').addEventListener('click', () => dlg.close());

  // When creating a departure, picking a trek pre-fills from your last departure of
  // that trek (days, price, group size and page details), or the trek's usual length.
  const DETAIL_FIELDS = ['overview', 'itinerary', 'included', 'not_included', 'meeting_point'];
  field('trek').addEventListener('change', () => {
    if (field('id').value) return;
    const slug = field('trek').value;
    const previous = rows.filter((r) => r.trek === slug).sort((a, b) => b.start_date.localeCompare(a.start_date))[0];
    if (previous) {
      field('days').value = String(previous.days);
      if (!field('price').value && previous.price) field('price').value = previous.price;
      field('group_max').value = String(previous.group_max);
      field('seats_left').value = String(previous.group_max);
      let copied = false;
      for (const k of DETAIL_FIELDS) {
        if (!field(k).value && previous[k]) { field(k).value = previous[k]; copied = true; }
      }
      $('copied-note').hidden = !copied;
      return;
    }
    if (field('days').value) return;
    const t = getTrek(slug);
    const max = t?.days.split('–').pop();
    if (max && /^\d+$/.test(max)) field('days').value = max;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const groupMax = Number(field('group_max').value);
    const seatsLeft = Number(field('seats_left').value);
    if (seatsLeft > groupMax) {
      formError.textContent = 'Seats left can’t be more than the group size.';
      formError.hidden = false;
      return;
    }
    const payload = {
      trek: field('trek').value,
      start_date: field('start_date').value,
      days: Number(field('days').value),
      price: field('price').value.trim() || null,
      group_max: groupMax,
      seats_left: seatsLeft,
      published: field('published').checked,
      overview: field('overview').value.trim() || null,
      itinerary: field('itinerary').value.trim() || null,
      included: field('included').value.trim() || null,
      not_included: field('not_included').value.trim() || null,
      meeting_point: field('meeting_point').value.trim() || null,
    };
    const id = field('id').value;
    const save = $<HTMLButtonElement>('save');
    save.disabled = true;
    const { error } = id
      ? await supabase.from('departures').update(payload).eq('id', id)
      : await supabase.from('departures').insert(payload);
    save.disabled = false;
    if (error) {
      formError.textContent = 'Could not save: ' + error.message;
      formError.hidden = false;
      return;
    }
    dlg.close();
    toast(id ? 'Departure updated' : 'Departure added');
    load();
  });

  checkAccess();
</script>
