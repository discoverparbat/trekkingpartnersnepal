---
import Base from '../layouts/Base.astro';
import DepartureCard from '../components/DepartureCard.astro';
import { upcomingDepartures } from '../data/departures';
const deps = upcomingDepartures();
---
<Base
  title="Fixed Departure Treks in Nepal – Join a Small Group | Trekking Partners Nepal"
  description="Upcoming fixed-departure group treks in Nepal with a licensed local guide. Join solo and trek with others on the same dates."
>
  <section class="page-hero" style="background-image:url('/images/hero.jpg')">
    <div class="container">
      <nav class="crumbs"><a href="/">Home</a> › Fixed departures</nav>
      <h1>Fixed departures</h1>
      <p>Small-group treks with a licensed local guide, guaranteed to run. Join on your own and meet your group on the trail.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="dep-grid">{deps.map((d) => <DepartureCard d={d} />)}</div>
    </div>
  </section>
</Base>
<style>
  .dep-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
</style>
