---
import Base from '../../layouts/Base.astro';
import TrekCard from '../../components/TrekCard.astro';
import DepartureList from '../../components/DepartureList.astro';
import TrekPosts from '../../components/TrekPosts.astro';
import RelatedNews from '../../components/RelatedNews.astro';
import TrekAlerts from '../../components/TrekAlerts.astro';
import TrekQuestions from '../../components/TrekQuestions.astro';
import { treks, treksInRegion, trekTitle, type Trek } from '../../data/treks';
import { getRegion, type Region } from '../../data/regions';

export function getStaticPaths() {
  return treks.map((trek) => ({
    params: { region: trek.region, trek: trek.slug },
    props: { trek, region: getRegion(trek.region)! },
  }));
}

const { trek, region } = Astro.props as { trek: Trek; region: Region };
const url = `https://trekkingpartnersnepal.com/${region.slug}/${trek.slug}/`;
const related = treksInRegion(region.slug).filter((t) => t.slug !== trek.slug).slice(0, 3);
const image = trek.image ?? region.hero;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://trekkingpartnersnepal.com/' },
      { '@type': 'ListItem', position: 2, name: `${region.name} treks`, item: `https://trekkingpartnersnepal.com/${region.slug}/` },
      { '@type': 'ListItem', position: 3, name: trek.name, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: trekTitle(trek),
    description: trek.summary,
    url,
    image: new URL(image, 'https://trekkingpartnersnepal.com').href,
    touristType: 'Trekkers',
  },
];
---
<Base
  title={`${trekTitle(trek)} – Find a Trekking Partner | Trekking Partners Nepal`}
  description={`Looking for a ${trek.name} trekking partner? ${trek.summary}`.slice(0, 158)}
  image={image}
  schema={schema}
>
  <section class="page-hero" style={`background-image:url('${image}')`}>
    <div class="container">
      <nav class="crumbs"><a href="/">Home</a> › <a href={`/${region.slug}/`}>{region.name}</a> › {trek.name}</nav>
      <h1>{trekTitle(trek)}</h1>
      <p>{trek.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <div>
        <TrekAlerts trek={trek.slug} />

        <ul class="factbox">
          <li><span>Duration</span><strong>{trek.days} days</strong></li>
          <li><span>Highest point</span><strong>{trek.maxAltitude}</strong></li>
          <li><span>Difficulty</span><strong>{trek.difficulty}</strong></li>
          <li><span>Best season</span><strong>{trek.season}</strong></li>
        </ul>

        {trek.restricted && (
          <div class="notice">
            <strong>Restricted area.</strong> This trek needs a special permit, a licensed guide and at least two trekkers. Finding a partner is the easiest way to make it happen.
          </div>
        )}

        <h2>Trekkers looking for partners</h2>
        <TrekPosts trek={trek.slug} label={trek.name} />

        <TrekQuestions trek={trek.slug} label={trek.name} />

        <RelatedNews trek={trek.slug} label={trek.name} />
      </div>

      <aside>
        <div class="side">
          <h3>Join a fixed departure</h3>
          <DepartureList trek={trek.slug} stack />
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="container">
        <div class="section-head">
          <h2>More treks in {region.name}</h2>
          <a href={`/${region.slug}/`} class="link-arrow">All {region.name} treks →</a>
        </div>
        <div class="grid grid-3">{related.map((t) => <TrekCard trek={t} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 40px; align-items: start; }
  .factbox { list-style: none; padding: 0; margin: 0 0 28px; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .factbox li { padding: 18px; border-right: 1px solid var(--line); }
  .factbox li:last-child { border-right: 0; }
  .factbox span { display: block; font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .factbox strong { font-family: var(--font-head); font-size: 1.05rem; }
  .notice { background: #fff6ee; border: 1px solid #f7d6bd; border-left: 4px solid var(--sun); border-radius: 10px; padding: 14px 18px; margin-bottom: 32px; }
  .side { position: sticky; top: 90px; background: linear-gradient(180deg, var(--sky-100), var(--white)); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .factbox { grid-template-columns: 1fr 1fr; }
    .factbox li:nth-child(2) { border-right: 0; }
    .factbox li:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .side { position: static; }
  }
</style>
