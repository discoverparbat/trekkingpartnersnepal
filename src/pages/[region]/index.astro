---
import Base from '../../layouts/Base.astro';
import TrekCard from '../../components/TrekCard.astro';
import { regions, type Region } from '../../data/regions';
import { treksInRegion } from '../../data/treks';

export function getStaticPaths() {
  return regions.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

const { region } = Astro.props as { region: Region };
const list = treksInRegion(region.slug);
const url = `https://trekkingpartnersnepal.com/${region.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://trekkingpartnersnepal.com/' },
      { '@type': 'ListItem', position: 2, name: `${region.name} treks`, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Treks in ${region.name}, Nepal`,
    itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `${url}${t.slug}/` })),
  },
];
---
<Base
  title={`${region.name} Treks – Find Trekking Partners | Trekking Partners Nepal`}
  description={`Find trekking partners for ${list.length} treks in ${region.name}, Nepal: ${list.slice(0, 4).map((t) => t.name).join(', ')} and more.`}
  image={region.hero}
  schema={schema}
>
  <section class="page-hero" style={`background-image:url('${region.hero}')`}>
    <div class="container">
      <nav class="crumbs"><a href="/">Home</a> › {region.name}</nav>
      <h1>{region.name} treks</h1>
      <p>{region.short}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="intro">
        <p>{region.intro}</p>
      </div>

      <div class="section-head">
        <h2>{list.length} treks in {region.name}</h2>
      </div>
      <div class="grid grid-3">
        {list.map((t) => <TrekCard trek={t} />)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="panel panel-dashed">
        <h3>Trekkers looking for partners in {region.name}</h3>
        <p style="color:var(--muted)">Partner posts are coming soon. Sign in with Google to post your dates and find people heading the same way.</p>
        <a href="/find-partners/" class="btn btn-sun">Post your trek</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 780px; font-size: 1.08rem; margin-bottom: 40px; }
</style>
