---
import Base from '../layouts/Base.astro';
---
<Base title="Trekker profile | Trekking Partners Nepal" description="A trekker on Trekking Partners Nepal." noindex>
  <section class="section">
    <div class="container narrow">
      <nav class="crumbs-dark"><a href="/find-partners/">Find partners</a> › <span id="crumb">Trekker</span></nav>

      <div id="loading" class="panel" style="text-align:center"><p class="muted" style="margin:0">Loading…</p></div>
      <div id="missing" class="panel panel-dashed" hidden>
        <h3>Trekker not found</h3>
        <a href="/find-partners/" class="btn btn-sun">Browse partner posts</a>
      </div>

      <div id="app" hidden>
        <div class="profile-card">
          <span id="p-avatar"></span>
          <div class="p-info">
            <h1 id="p-name"></h1>
            <ul id="p-facts" class="p-facts"></ul>
            <p id="p-since" class="muted"></p>
          </div>
          <a id="p-edit" href="/account/" class="btn btn-outline btn-sm" hidden>Edit my profile</a>
        </div>

        <h2 id="posts-title" class="posts-title">Open posts</h2>
        <div id="posts" class="post-grid"></div>
        <p id="no-posts" class="muted" hidden>No open posts right now.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 900px; }
  .muted { color: var(--muted); }
  .crumbs-dark { font-size: .88rem; color: var(--muted); margin-bottom: 14px; }
  .crumbs-dark a { color: var(--sky-600); text-decoration: none; }
  .profile-card { display: flex; align-items: center; gap: 22px; background: linear-gradient(135deg, var(--white), var(--sky-100)); border: 1px solid var(--line); border-radius: 18px; padding: 28px; box-shadow: var(--shadow); flex-wrap: wrap; }
  .profile-card :global(.avatar) { width: 96px; height: 96px; font-size: 2rem; border: 4px solid var(--white); box-shadow: 0 6px 18px -8px rgba(8,22,52,.4); }
  .p-info { flex: 1; min-width: 200px; }
  .p-info h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); margin-bottom: 8px; }
  .p-facts { list-style: none; padding: 0; margin: 0 0 6px; display: flex; gap: 8px; flex-wrap: wrap; }
  .p-facts :global(li) { background: var(--white); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: .88rem; font-weight: 500; }
  .p-info p { margin: 0; font-size: .9rem; }
  .posts-title { font-size: 1.4rem; margin: 40px 0 16px; }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { getUser } from '../lib/auth';
  import { fetchTrips, postCard, avatar, authorName, el } from '../lib/posts';

  const $ = (id: string) => document.getElementById(id)!;
  const id = new URLSearchParams(location.search).get('id') ?? '';
  const GENDER: Record<string, string> = { female: 'Female', male: 'Male', 'non-binary': 'Non-binary' };

  async function start() {
    const { data: p } = id
      ? await supabase.from('public_profiles').select('id, display_name, avatar_url, nationality, gender, age, created_at').eq('id', id).maybeSingle()
      : { data: null };
    $('loading').hidden = true;
    if (!p) { $('missing').hidden = false; return; }

    const name = authorName(p);
    document.title = `${name} | Trekking Partners Nepal`;
    $('crumb').textContent = name;
    $('p-avatar').replaceChildren(avatar(p, 96));
    $('p-name').textContent = name;
    const facts = $('p-facts');
    if (p.age) facts.append(el('li', '', `${p.age} years old`));
    if (p.gender && GENDER[p.gender]) facts.append(el('li', '', GENDER[p.gender]));
    if (p.nationality) facts.append(el('li', '', p.nationality));
    if (p.created_at) {
      $('p-since').textContent = 'Member since ' + new Date(p.created_at).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    }
    $('posts-title').textContent = `${name.split(' ')[0]}’s open posts`;
    $('app').hidden = false;

    const me = await getUser();
    $('p-edit').hidden = me?.id !== p.id;

    let trips: any[] = [];
    try { trips = await fetchTrips({ userId: p.id }); } catch {}
    $('posts').replaceChildren(...trips.map(postCard));
    $('no-posts').hidden = trips.length > 0;
  }

  start();
</script>
