---
// "Fixed departures run by Discover Parbat" strip with review links.
import { operator } from '../data/operator';
---
<div class="op-bar">
  <p class="op-text">
    Fixed departures are run by <a href={operator.site} target="_blank" rel="noopener">{operator.name}</a>,
    a licensed local trekking company in Parbat.
  </p>
  <div class="op-links">
    <span class="op-label">Check their reviews:</span>
    <a href={operator.facebook} target="_blank" rel="noopener" class="op-link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
      Facebook
    </a>
    <a href={operator.maps} target="_blank" rel="noopener" class="op-link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#EA4335" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      Google Maps
    </a>
  </div>
</div>

<style>
  .op-bar { display: flex; align-items: center; justify-content: space-between; gap: 14px 24px; flex-wrap: wrap; margin-top: 24px; padding: 14px 18px; background: var(--sky-50); border: 1px solid var(--line); border-radius: 12px; }
  .op-text { margin: 0; font-size: .93rem; color: var(--muted); }
  .op-text a { font-weight: 700; color: var(--sky-700); text-decoration: none; }
  .op-text a:hover { text-decoration: underline; }
  .op-links { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .op-label { font-size: .85rem; font-weight: 600; }
  .op-link { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); font-size: .86rem; font-weight: 600; color: var(--ink); text-decoration: none; }
  .op-link:hover { border-color: var(--sky-400); }
  .op-link svg { width: 16px; height: 16px; }
</style>
