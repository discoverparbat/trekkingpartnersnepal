---
// Homepage: latest admin trail notes + latest Community questions, loaded live from Supabase.
---
<section class="section community-home">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Community</span>
        <h2>On the trail right now</h2>
        <p>Live trail updates from our team, and what trekkers are asking this week.</p>
      </div>
      <a href="/community/" class="link-arrow">Visit the Community →</a>
    </div>

    <div class="ch-grid">
      <div class="notes">
        <div class="notes-head"><h3><span class="notes-pin">Live</span> Trail &amp; weather updates</h3></div>
        <div id="ch-notes"><p class="notes-empty">Loading updates…</p></div>
      </div>

      <div class="ch-questions">
        <div id="ch-list" class="ch-list">
          {[1, 2, 3].map(() => <div class="ch-row skeleton" aria-hidden="true"></div>)}
        </div>
        <div class="ch-foot">
          <a href="/community/ask/" class="btn btn-sun btn-sm">Ask a question</a>
          <a href="/community/" class="link-arrow">All questions →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .community-home { padding-top: 24px; }
  .ch-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 20px; align-items: start; }
  @media (max-width: 860px) { .ch-grid { grid-template-columns: 1fr; } }
  .ch-questions { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 6px 18px 16px; }
  .ch-list :global(.ch-row) { display: block; padding: 13px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .ch-list :global(.ch-row.skeleton) { height: 58px; border-radius: 10px; margin: 10px 0; border: 0; }
  .ch-list :global(.ch-row strong) { display: block; font-weight: 600; font-size: .95rem; line-height: 1.35; overflow-wrap: anywhere; }
  .ch-list :global(a.ch-row:hover strong) { color: var(--sky-600); }
  .ch-list :global(.ch-row small) { display: block; margin-top: 3px; color: var(--muted); font-size: .8rem; }
  .ch-list :global(.ch-row small b) { color: var(--sky-700); font-weight: 600; }
  .ch-list :global(.ch-row small b.none) { color: #8a4b08; }
  .ch-list :global(.ch-row small i) { color: #1b6b3a; font-style: normal; font-weight: 600; }
  .ch-list :global(.ch-empty) { color: var(--muted); font-size: .92rem; padding: 14px 0; margin: 0; border-bottom: 1px solid var(--line); }
  .ch-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
</style>

<script>
  import { fetchQuestions, fetchNotes, noteRow, questionUrl, trekName, answersLabel } from '../lib/community';
  import { topicLabel } from '../data/community';
  import { timeAgo } from '../lib/posts';

  const notesBox = document.getElementById('ch-notes')!;
  const list = document.getElementById('ch-list')!;

  fetchNotes(3).then((notes) => {
    if (!notes.length) {
      const p = document.createElement('p');
      p.className = 'notes-empty';
      p.textContent = 'No current updates. Our team posts trail closures and weather changes here.';
      notesBox.replaceChildren(p);
    } else {
      notesBox.replaceChildren(...notes.map((n) => noteRow(n)));
    }
  }).catch(() => notesBox.replaceChildren());

  fetchQuestions({ limit: 4 }).then((qs) => {
    if (!qs.length) {
      const p = document.createElement('p');
      p.className = 'ch-empty';
      p.textContent = 'No questions yet. Ask about trail conditions, permits or gear – trekkers and our team will answer.';
      list.replaceChildren(p);
      return;
    }
    list.replaceChildren(...qs.map((q) => {
      const a = document.createElement('a');
      a.className = 'ch-row';
      a.href = questionUrl(q.id);
      const title = document.createElement('strong');
      title.textContent = q.title;
      const meta = document.createElement('small');
      meta.append(`${trekName(q.trek)} · ${topicLabel(q.topic)} · ${timeAgo(q.created_at)} · `);
      const count = document.createElement('b');
      count.textContent = answersLabel(q.answers_count);
      if (!q.answers_count) count.className = 'none';
      meta.append(count);
      if (q.best_answer_id) {
        const ok = document.createElement('i');
        ok.textContent = ' · ✓ Answered';
        meta.append(ok);
      }
      a.append(title, meta);
      return a;
    }));
  }).catch((e) => {
    console.error('Community:', e.message);
    list.replaceChildren();
  });
</script>
