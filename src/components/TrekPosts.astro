---
// Open partner posts for one trek or one region, loaded live from Supabase.
interface Props {
  trek?: string;
  region?: string;
  label: string;       // e.g. "Annapurna Base Camp" or "Annapurna"
}
const { trek, region, label } = Astro.props;
const postHref = trek ? `/find-partners/new/?trek=${trek}` : '/find-partners/new/';
---
<div class="trek-posts" data-trek={trek ?? ''} data-region={region ?? ''}>
  <div class="post-grid" data-grid>
    <div class="post skeleton" aria-hidden="true"></div>
    <div class="post skeleton" aria-hidden="true"></div>
  </div>
  <div class="panel panel-dashed" data-empty hidden>
    <p style="color:var(--muted)">No open partner posts for {label} yet. Be the first – post your dates and others heading this way will find you.</p>
    <a href={postHref} class="btn btn-sun">Post a trip</a>
  </div>
  <div class="trek-posts-cta" data-cta hidden>
    <a href={postHref} class="btn btn-sun">Post your own trip</a>
  </div>
</div>

<style>
  .trek-posts-cta { margin-top: 18px; }
</style>

<script>
  import { fetchTrips, postCard } from '../lib/posts';

  document.querySelectorAll<HTMLElement>('.trek-posts').forEach(async (box) => {
    const grid = box.querySelector<HTMLElement>('[data-grid]')!;
    const empty = box.querySelector<HTMLElement>('[data-empty]')!;
    const cta = box.querySelector<HTMLElement>('[data-cta]')!;
    try {
      const trips = await fetchTrips({ trek: box.dataset.trek || undefined, region: box.dataset.region || undefined });
      grid.replaceChildren(...trips.map(postCard));
      grid.hidden = trips.length === 0;
      empty.hidden = trips.length > 0;
      cta.hidden = trips.length === 0;
    } catch (e: any) {
      console.error('Partner posts:', e.message);
      grid.hidden = true;
      empty.hidden = false;
    }
  });
</script>
