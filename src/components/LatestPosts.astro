---
// Latest 4 open partner posts from any region, loaded live from Supabase.
const FB = 'https://www.facebook.com/groups/887606059135821';
---
<section class="section latest">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">Independent trekkers</span>
        <h2>Latest partner posts</h2>
        <p>Trekkers looking for company on the trail right now, across all regions.</p>
      </div>
      <a href="/find-partners/" class="link-arrow">See all posts →</a>
    </div>

    <div id="latest-posts" class="post-grid four" aria-live="polite">
      {[1, 2, 3, 4].map(() => <div class="post skeleton" aria-hidden="true"></div>)}
    </div>

    <div id="latest-empty" class="panel panel-dashed" hidden>
      <h3>No open posts yet</h3>
      <p style="color:var(--muted)">Be the first to post your trek dates, or ask in our Facebook group.</p>
      <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <a href="/find-partners/new/" class="btn btn-sun">Post your trek</a>
        <a href={FB} class="btn btn-outline" target="_blank" rel="noopener">Facebook group</a>
      </div>
    </div>
  </div>
</section>

<style>
  .latest { padding-top: 64px; padding-bottom: 24px; }
</style>

<script>
  import { fetchTrips, postCard } from '../lib/posts';

  const grid = document.getElementById('latest-posts')!;
  const empty = document.getElementById('latest-empty')!;

  fetchTrips({ limit: 4 })
    .then((trips) => {
      grid.replaceChildren(...trips.map(postCard));
      grid.hidden = trips.length === 0;
      empty.hidden = trips.length > 0;
    })
    .catch((e) => {
      console.error('Latest posts:', e.message);
      grid.hidden = true;
      empty.hidden = false;
    });
</script>
