---
import '../styles/global.css';
import { regions } from '../data/regions';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object | object[];
  noindex?: boolean;
  // News articles: og:type "article" plus published/modified dates
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
}

const { title, description, image = '/images/hero.jpg', schema, noindex = false, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Trek Partners" />
    {!noindex && <meta name="robots" content="max-image-preview:large" />}
    <meta name="theme-color" content="#081634" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:site_name" content="Trekking Partners Nepal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="Trekking Partners Nepal – News & updates" href="/news/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">
          <img src="/logo.jpg" alt="" width="36" height="36" />
          Trekking Partners Nepal
        </a>
        <nav class="nav">
          <a href="/#regions">Regions</a>
          <a href="/fixed-departures/">Fixed departures</a>
          <a href="/find-partners/">Find partners</a>
          <a href="/community/">Community</a>
          <a href="/news/">News</a>
          <a href="/login/" class="btn btn-sun" id="nav-login">Log in</a>
        </nav>
        <div class="bell-wrap" id="bell-wrap" hidden>
          <button type="button" class="bell" id="bell" aria-label="Notifications" aria-expanded="false" aria-controls="bell-panel">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22Zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-1.7 1.7A1 1 0 0 0 4 19.4h16a1 1 0 0 0 .7-1.7L19 16Z"/></svg>
            <span class="bell-count" id="bell-count" hidden></span>
          </button>
          <div class="bell-panel" id="bell-panel" role="region" aria-label="Notifications" hidden>
            <div class="bell-head">
              <strong>Notifications</strong>
              <button type="button" id="bell-all" class="bell-all" hidden>Mark all as read</button>
            </div>
            <div class="bell-list" id="bell-list"><p class="bell-empty">Loading…</p></div>
            <a class="bell-foot" href="/account/#email-alerts">Email settings</a>
          </div>
        </div>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false">☰</button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>Trekking Partners Nepal</h4>
            <p>Find people to share the trail with in Nepal, or join one of our small-group fixed departures.</p>
            <p><a href="mailto:hello@trekkingpartnersnepal.com">hello@trekkingpartnersnepal.com</a><br /><a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener">Join our Facebook group →</a></p>
          </div>
          <div>
            <h4>Regions</h4>
            <ul>
              {regions.slice(0, Math.ceil(regions.length / 2)).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>&nbsp;</h4>
            <ul>
              {regions.slice(Math.ceil(regions.length / 2)).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul>
              <li><a href="/fixed-departures/">Fixed departures</a></li>
              <li><a href="/find-partners/">Find partners</a></li>
              <li><a href="/community/">Community Q&amp;A</a></li>
              <li><a href="/news/">News &amp; updates</a></li>
              <li><a href="/safety/">Safety tips</a></li>
              <li><a href="/about/">About us</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} Trekking Partners Nepal</span>
          <span>Made in Nepal</span>
        </div>
      </div>
    </footer>

    <script>
      // Signed in? Swap "Log in" for the trekker's photo and a link to their account.
      import { supabase } from '../lib/supabase';
      supabase.auth.getSession().then(({ data: { session } }) => {
        const link = document.getElementById('nav-login') as HTMLAnchorElement | null;
        if (!session || !link) return;
        const m = session.user.user_metadata || {};
        link.href = '/account/';
        link.className = 'nav-account';
        link.textContent = '';
        if (m.avatar_url) {
          const img = document.createElement('img');
          img.src = m.avatar_url; img.alt = ''; img.className = 'avatar';
          img.referrerPolicy = 'no-referrer';
          link.append(img);
        }
        link.append('My account');
      });
    </script>

    <script>
      // Notification bell: welcome, first post and reply notifications for signed-in members.
      import { supabase } from '../lib/supabase';
      import { fetchNotices, unreadCount, markRead, markAllRead, markTripRead, markQuestionRead, watchNotices, type NoticeView } from '../lib/notifications';
      import { timeAgo } from '../lib/posts';

      const wrap = document.getElementById('bell-wrap')!;
      const bell = document.getElementById('bell') as HTMLButtonElement;
      const panel = document.getElementById('bell-panel')!;
      const list = document.getElementById('bell-list')!;
      const badge = document.getElementById('bell-count')!;
      const allBtn = document.getElementById('bell-all') as HTMLButtonElement;

      function setCount(n: number) {
        badge.hidden = n === 0;
        badge.textContent = n > 9 ? '9+' : String(n);
        bell.setAttribute('aria-label', n ? `Notifications, ${n} unread` : 'Notifications');
        allBtn.hidden = n === 0;
      }

      function row(n: NoticeView, userId: string) {
        const a = document.createElement('a');
        a.className = 'bell-item' + (n.read_at ? '' : ' unread');
        a.href = n.href;
        let pic: HTMLElement;
        if (n.actorAvatar) {
          const img = document.createElement('img');
          img.src = n.actorAvatar; img.alt = ''; img.width = 36; img.height = 36;
          img.referrerPolicy = 'no-referrer'; img.loading = 'lazy';
          pic = img;
        } else {
          pic = document.createElement('span');
          pic.textContent = n.icon;
        }
        pic.classList.add('bell-pic');
        const body = document.createElement('span');
        body.className = 'bell-body';
        const msg = document.createElement('span');
        const b = document.createElement('strong');
        b.textContent = n.strong;
        msg.append(b, n.text);
        const when = document.createElement('span');
        when.className = 'bell-when';
        when.textContent = timeAgo(n.created_at);
        body.append(msg, when);
        a.append(pic, body);
        a.addEventListener('click', () => { if (!n.read_at) markRead([n.id]); });
        return a;
      }

      async function render(userId: string) {
        const items = await fetchNotices(userId);
        if (!items.length) {
          const p = document.createElement('p');
          p.className = 'bell-empty';
          p.textContent = 'No notifications yet. We’ll let you know here when someone replies to your posts or answers your questions.';
          list.replaceChildren(p);
        } else {
          list.replaceChildren(...items.map((n) => row(n, userId)));
        }
      }

      function close() {
        panel.hidden = true;
        bell.setAttribute('aria-expanded', 'false');
      }

      supabase.auth.getSession().then(async ({ data: { session } }) => {
        if (!session) return;
        const userId = session.user.id;
        wrap.hidden = false;

        // Opening a post marks its notifications as read
        const params = new URLSearchParams(location.search);
        if (location.pathname.startsWith('/post/') && params.get('id')) {
          await markTripRead(userId, params.get('id')!);
        }
        // …and opening a Community question marks its answer notifications as read
        if (location.pathname.startsWith('/community/question/') && params.get('id')) {
          await markQuestionRead(userId, params.get('id')!);
        }

        const refresh = async () => {
          setCount(await unreadCount(userId));
          if (!panel.hidden) render(userId);
        };
        await refresh();
        watchNotices(userId, refresh);

        bell.addEventListener('click', () => {
          const open = panel.hidden;
          panel.hidden = !open;
          bell.setAttribute('aria-expanded', String(open));
          if (open) render(userId);
        });
        allBtn.addEventListener('click', async () => {
          await markAllRead(userId);
          setCount(0);
          render(userId);
        });
        document.addEventListener('click', (e) => { if (!wrap.contains(e.target as Node)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { close(); bell.focus(); } });
      });
    </script>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
