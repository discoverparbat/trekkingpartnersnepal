---
import '../styles/global.css';
import { regions } from '../data/regions';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object | object[];
  noindex?: boolean;
  // News articles: og:type "article" plus published/modified dates
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
}

const { title, description, image = '/images/hero.jpg', schema, noindex = false, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Trek Partners" />
    {!noindex && <meta name="robots" content="max-image-preview:large" />}
    <meta name="theme-color" content="#081634" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta property="og:site_name" content="Trekking Partners Nepal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="Trekking Partners Nepal – News & updates" href="/news/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">
          <img src="/logo.jpg" alt="" width="36" height="36" />
          Trekking Partners Nepal
        </a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false">☰</button>
        <nav class="nav">
          <a href="/#regions">Regions</a>
          <a href="/fixed-departures/">Fixed departures</a>
          <a href="/find-partners/">Find partners</a>
          <a href="/news/">News</a>
          <a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener">Facebook group</a>
          <a href="/login/" class="btn btn-sun" id="nav-login">Log in</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>Trekking Partners Nepal</h4>
            <p>Find people to share the trail with in Nepal, or join one of our small-group fixed departures.</p>
            <p><a href="mailto:hello@trekkingpartnersnepal.com">hello@trekkingpartnersnepal.com</a><br /><a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener">Join our Facebook group →</a></p>
          </div>
          <div>
            <h4>Regions</h4>
            <ul>
              {regions.slice(0, 3).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>&nbsp;</h4>
            <ul>
              {regions.slice(3).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul>
              <li><a href="/fixed-departures/">Fixed departures</a></li>
              <li><a href="/find-partners/">Find partners</a></li>
              <li><a href="/news/">News &amp; updates</a></li>
              <li><a href="/safety/">Safety tips</a></li>
              <li><a href="/about/">About us</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} Trekking Partners Nepal</span>
          <span>Made in Nepal</span>
        </div>
      </div>
    </footer>

    <script>
      // Signed in? Swap "Log in" for the trekker's photo and a link to their account.
      import { supabase } from '../lib/supabase';
      supabase.auth.getSession().then(({ data: { session } }) => {
        const link = document.getElementById('nav-login') as HTMLAnchorElement | null;
        if (!session || !link) return;
        const m = session.user.user_metadata || {};
        link.href = '/account/';
        link.className = 'nav-account';
        link.textContent = '';
        if (m.avatar_url) {
          const img = document.createElement('img');
          img.src = m.avatar_url; img.alt = ''; img.className = 'avatar';
          img.referrerPolicy = 'no-referrer';
          link.append(img);
        }
        link.append('My account');
      });
    </script>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
