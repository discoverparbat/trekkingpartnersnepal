---
import '../styles/global.css';
import { regions } from '../data/regions';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const { title, description, image = '/images/hero.jpg', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#081634" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trekking Partners Nepal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">
          <img src="/logo.jpg" alt="" width="36" height="36" />
          Trekking Partners Nepal
        </a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false">☰</button>
        <nav class="nav">
          <a href="/#regions">Regions</a>
          <a href="/fixed-departures/">Fixed departures</a>
          <a href="/find-partners/">Find partners</a>
          <a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener">Facebook group</a>
          <a href="/login/" class="btn btn-sun">Log in</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h4>Trekking Partners Nepal</h4>
            <p>Find people to share the trail with in Nepal, or join one of our small-group fixed departures.</p>
            <p><a href="mailto:hello@trekkingpartnersnepal.com">hello@trekkingpartnersnepal.com</a><br /><a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener">Join our Facebook group →</a></p>
          </div>
          <div>
            <h4>Regions</h4>
            <ul>
              {regions.slice(0, 3).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>&nbsp;</h4>
            <ul>
              {regions.slice(3).map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Site</h4>
            <ul>
              <li><a href="/fixed-departures/">Fixed departures</a></li>
              <li><a href="/find-partners/">Find partners</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} Trekking Partners Nepal</span>
          <span>Made in Nepal</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
