---
import Base from '../layouts/Base.astro';
---
<Base title="Fixed departure | Trekking Partners Nepal" description="Join a small-group fixed-departure trek in Nepal with a licensed local guide.">
  <section class="page-hero dep-hero" id="hero" style="background-image:url('/images/hero.jpg')">
    <div class="container">
      <nav class="crumbs"><a href="/">Home</a> › <a href="/fixed-departures/">Fixed departures</a> › <span id="crumb">Departure</span></nav>
      <span class="eyebrow-light" id="h-region">Fixed departure</span>
      <h1 id="h-title">Loading…</h1>
      <p id="h-dates"></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="missing" class="panel panel-dashed" hidden>
        <h3>Departure not found</h3>
        <p class="muted">It may have finished or been removed.</p>
        <a href="/fixed-departures/" class="btn btn-sun">See upcoming departures</a>
      </div>

      <div id="app" class="dep-layout" hidden>
        <div class="dep-body">
          <ul class="factbox" id="facts"></ul>

          <div id="s-overview" class="block" hidden>
            <h2>Overview</h2>
            <p id="overview" class="prose"></p>
          </div>

          <div id="s-itinerary" class="block" hidden>
            <h2>Itinerary</h2>
            <ol id="itinerary" class="timeline"></ol>
          </div>

          <div id="s-incl" class="block incl-grid" hidden>
            <div id="s-included" hidden>
              <h2>What’s included</h2>
              <ul id="included" class="ticks yes"></ul>
            </div>
            <div id="s-notincluded" hidden>
              <h2>Not included</h2>
              <ul id="notincluded" class="ticks no"></ul>
            </div>
          </div>

          <div id="s-meeting" class="block" hidden>
            <h2>Meeting point</h2>
            <p id="meeting" class="prose"></p>
          </div>

          <div id="s-nodetails" class="panel panel-dashed" hidden>
            <p class="muted" style="margin:0 0 12px">The full day-by-day itinerary is available on request.</p>
            <a id="trek-link-2" class="link-arrow" href="#">Read about this trek →</a>
          </div>

          <a id="trek-link" class="link-arrow" href="#">More about this trek →</a>
        </div>

        <aside>
          <div class="join" id="enquire">
            <div class="join-date" id="j-date"></div>
            <div class="join-price" id="j-price"></div>
            <div class="dep-seats">
              <div class="bar"><span id="j-bar"></span></div>
              <span id="j-seats" class="seats"></span>
            </div>
            <a id="j-email" class="btn btn-sun join-btn" href="#">Enquire by email</a>
            <a href="https://www.facebook.com/groups/887606059135821" target="_blank" rel="noopener" class="btn btn-outline join-btn">Ask in our Facebook group</a>
            <ul class="join-points">
              <li>Licensed local guide</li>
              <li>Small group – join on your own</li>
              <li>We reply within 24 hours</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .muted { color: var(--muted); }
  .eyebrow-light { display: inline-block; font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #cfe3ff; margin-bottom: 8px; }
  .dep-hero h1 { margin-bottom: 6px; }
  .dep-hero #h-dates { font-size: 1.15rem; font-weight: 500; }
  .dep-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; align-items: start; }
  .dep-body > .link-arrow { display: inline-block; margin-top: 8px; }
  .factbox { list-style: none; padding: 0; margin: 0 0 32px; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .factbox :global(li) { padding: 16px 18px; border-right: 1px solid var(--line); }
  .factbox :global(li:last-child) { border-right: 0; }
  .factbox :global(span) { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .factbox :global(strong) { font-family: var(--font-head); font-size: 1.02rem; }
  .block { margin-bottom: 36px; }
  .block h2 { font-size: 1.35rem; margin-bottom: 14px; }
  .prose { white-space: pre-wrap; line-height: 1.75; margin: 0; }

  .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 21px; top: 8px; bottom: 8px; width: 2px; background: var(--sky-200); }
  .timeline :global(li) { position: relative; display: flex; gap: 16px; padding: 0 0 18px; }
  .timeline :global(.day) { flex: 0 0 44px; height: 44px; border-radius: 50%; background: linear-gradient(180deg, var(--sky-500), var(--night-800)); color: var(--white); display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; font-size: .95rem; position: relative; z-index: 1; }
  .timeline :global(.day-text) { background: var(--white); border: 1px solid var(--line); border-radius: 12px; padding: 11px 16px; flex: 1; align-self: center; }

  .incl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ticks :global(li) { display: flex; gap: 10px; align-items: flex-start; }
  .ticks :global(li)::before { flex: 0 0 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .75rem; font-weight: 700; margin-top: 2px; }
  .ticks.yes :global(li)::before { content: '✓'; background: #e3f6ec; color: #1b7a47; }
  .ticks.no :global(li)::before { content: '✕'; background: #fde8e8; color: #a8282d; }

  .join { position: sticky; top: 90px; background: var(--white); border: 1px solid var(--line); border-top: 4px solid var(--sun); border-radius: 18px; padding: 24px; box-shadow: var(--shadow); }
  .join-date { font-family: var(--font-head); font-size: 1.3rem; font-weight: 700; }
  .join-price { color: var(--muted); margin: 4px 0 6px; }
  .join-price :global(strong) { color: var(--ink); font-size: 1.25rem; }
  .join .bar span { background: var(--sky-500); }
  .join-btn { width: 100%; margin-top: 10px; }
  .join-points { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 6px; font-size: .88rem; color: var(--muted); }
  .join-points li::before { content: '✓ '; color: #1b7a47; font-weight: 700; }

  @media (max-width: 960px) {
    .dep-layout { grid-template-columns: 1fr; }
    .join { position: static; }
    .factbox { grid-template-columns: 1fr 1fr; }
    .factbox :global(li:nth-child(2)) { border-right: 0; }
    .factbox :global(li:nth-child(-n+2)) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 600px) { .incl-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { fetchDeparture } from '../data/departures';
  import { getTrek } from '../data/treks';
  import { getRegion } from '../data/regions';

  const $ = (id: string) => document.getElementById(id)!;
  const id = new URLSearchParams(location.search).get('id') ?? '';

  const lines = (text?: string) => (text ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
  const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleDateString('en-GB', o);

  function li(text: string) {
    const e = document.createElement('li');
    e.textContent = text;
    return e;
  }

  function fact(label: string, value: string) {
    const e = document.createElement('li');
    const s = document.createElement('span'); s.textContent = label;
    const b = document.createElement('strong'); b.textContent = value;
    e.append(s, b);
    return e;
  }

  async function start() {
    const d = id ? await fetchDeparture(id) : null;
    const trek = d ? getTrek(d.trek) : undefined;
    const region = trek ? getRegion(trek.region) : undefined;
    if (!d || !trek || !region) {
      $('h-title').textContent = 'Departure not found';
      $('missing').hidden = false;
      return;
    }

    const start = new Date(d.start + 'T00:00:00');
    const end = new Date(start); end.setDate(end.getDate() + d.days - 1);
    const range = `${fmt(start, { day: 'numeric', month: 'short' })} – ${fmt(end, { day: 'numeric', month: 'short', year: 'numeric' })}`;
    const full = d.seatsLeft <= 0;

    document.title = `${trek.name} – ${fmt(start, { day: 'numeric', month: 'short', year: 'numeric' })} fixed departure | Trekking Partners Nepal`;
    ($('hero') as HTMLElement).style.backgroundImage = `url('${trek.image ?? region.hero}')`;
    $('crumb').textContent = trek.name;
    $('h-region').textContent = `${region.name} · Fixed departure`;
    $('h-title').textContent = `${trek.name} Trek`;
    $('h-dates').textContent = `${range} · ${d.days} days`;

    $('facts').append(
      fact('Dates', range),
      fact('Duration', `${d.days} days`),
      fact('Highest point', trek.maxAltitude.split(' (')[0]),
      fact('Difficulty', trek.difficulty),
    );

    if (d.overview) { $('overview').textContent = d.overview; $('s-overview').hidden = false; }

    const days = lines(d.itinerary);
    if (days.length) {
      $('itinerary').replaceChildren(...days.map((text, i) => {
        // "Day 3: Ghorepani to Tadapani" → badge "3" + "Ghorepani to Tadapani"
        const m = text.match(/^day\s*(\d+)\s*[:.\-–]\s*(.*)$/i);
        const item = document.createElement('li');
        const badge = document.createElement('span'); badge.className = 'day'; badge.textContent = m ? m[1] : String(i + 1);
        const body = document.createElement('div'); body.className = 'day-text'; body.textContent = m ? m[2] : text;
        item.append(badge, body);
        return item;
      }));
      $('s-itinerary').hidden = false;
    }

    const inc = lines(d.included), exc = lines(d.notIncluded);
    if (inc.length) { $('included').replaceChildren(...inc.map(li)); $('s-included').hidden = false; }
    if (exc.length) { $('notincluded').replaceChildren(...exc.map(li)); $('s-notincluded').hidden = false; }
    $('s-incl').hidden = !inc.length && !exc.length;

    if (d.meetingPoint) { $('meeting').textContent = d.meetingPoint; $('s-meeting').hidden = false; }

    const trekUrl = `/${region.slug}/${trek.slug}/`;
    ($('trek-link') as HTMLAnchorElement).href = trekUrl;
    ($('trek-link-2') as HTMLAnchorElement).href = trekUrl;
    const noDetails = !d.overview && !days.length && !inc.length && !exc.length;
    $('s-nodetails').hidden = !noDetails;
    $('trek-link').hidden = noDetails;

    // Booking box
    $('j-date').textContent = range;
    if (d.price) {
      $('j-price').append('From ');
      const b = document.createElement('strong'); b.textContent = d.price;
      $('j-price').append(b, ' per person');
    } else {
      $('j-price').textContent = 'Ask us for the price';
    }
    const filled = Math.round(((d.groupMax - d.seatsLeft) / d.groupMax) * 100);
    ($('j-bar') as HTMLElement).style.width = `${full ? 100 : filled}%`;
    $('j-seats').textContent = full ? 'Fully booked' : `${d.seatsLeft} of ${d.groupMax} seats left`;
    if (!full && d.seatsLeft <= 4) $('j-seats').classList.add('few');

    const subject = full ? `Next departure: ${trek.name}` : `Fixed departure: ${trek.name} – ${d.start}`;
    const body = full
      ? `Hello,\n\nThe ${trek.name} departure on ${range} is full. Please let me know about the next available date.\n\nThank you`
      : `Hello,\n\nI'd like to join the ${trek.name} fixed departure on ${range}.\n\nNumber of people: \nNationality: \nQuestions: \n\nThank you`;
    const email = $('j-email') as HTMLAnchorElement;
    email.href = `mailto:hello@trekkingpartnersnepal.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (full) email.textContent = 'Ask about the next date';

    $('app').hidden = false;
  }

  start();
</script>
